   "source": [
    "ct = QuantumCircuit(8)\n",
    "\n",
    "ct.cx(1,3)\n",
    "ct.cx(2,3)\n",
    "ct.cx(3,4)\n",
    "ct.cx(0,4)\n",
    "ct.ccx(1,2,5)\n",
    "ct.ccx(0,3,6)\n",
    "ct.x([5,6,7])\n",
    "ct.ccx(5,6,7)\n",
    "ct.x([5,6])\n",
    "ct.draw('mpl')"
   ]
